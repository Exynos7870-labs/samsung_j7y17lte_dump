	uart@13800000 {
		clock-names = "gate_pclk1\0gate_uart1\0sclk_uart1";
		clocks = <0x0f 0xac 0x0f 0x26c 0x0f 0x26c>;
		compatible = "samsung,exynos-uart";
		interrupts = <0x00 0x1a5 0x00>;
		pinctrl-0 = <0x12>;
		pinctrl-names = "default";
		reg = <0x00 0x13800000 0x100>;
		samsung,fifo-size = <0x10>;
		samsung,separate-uart-clk;
		status = "disabled";
	};

	uart@13810000 {
		clock-names = "gate_pclk0\0gate_uart0\0sclk_uart0";
		clocks = <0x0f 0xab 0x0f 0x26d 0x0f 0x26d>;
		compatible = "samsung,exynos-uart";
		interrupts = <0x00 0x1a6 0x00>;
		pinctrl-0 = <0x11>;
		pinctrl-names = "default";
		reg = <0x00 0x13810000 0x100>;
		samsung,fifo-size = <0x100>;
		samsung,separate-uart-clk;
		status = "okay";
	};

	uart@13820000 {
		clock-names = "gate_pclk2\0gate_uart2\0sclk_uart2";
		clocks = <0x0f 0xaa 0x0f 0x26e 0x0f 0x26e>;
		compatible = "samsung,exynos-uart";
		interrupts = <0x00 0x1a7 0x00>;
		pinctrl-0 = <0x13>;
		pinctrl-1 = <0x14>;
		pinctrl-names = "default\0uart_sleep";
		reg = <0x00 0x13820000 0x100>;
		samsung,fifo-size = <0x100>;
		samsung,separate-uart-clk;
		status = "okay";
	};

	uart_sel {
		compatible = "samsung,exynos-uart-sel";
		int_ap2cp_uart_noti = <0x0f>;
		mbx_ap2cp_uart_noti = <0x1e>;
	};

	usb@13600000 {
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		clock-names = "usbdrd20\0phyumux\0usb_pll";
		clocks = <0x0f 0x14f 0x0f 0x150 0x0f 0x15e>;
		compatible = "samsung,exynos7870-dwusb2";
		linux,phandle = <0x4a>;
		phandle = <0x4a>;
		ranges;
		reg = <0x00 0x13600000 0x10000>;
		status = "okay";

		dwc3 {
			compatible = "synopsys,dwc3";
			dr_mode = "otg";
			enable_sprs_transfer;
			interrupts = <0x00 0xe6 0x00>;
			is_not_vbus_pad;
			maximum-speed = "high-speed";
			phy-names = "usb2-phy\0usb3-phy";
			phys = <0x49 0x00 0x49 0x01>;
			reg = <0x00 0x13600000 0x10000>;
		};
	};

	usb_notifier {
		compatible = "samsung,usb-notifier";
		udc = <0x4a>;
	};

	watchdog@10170000 {
		clock-names = "rate_watchdog\0gate_watchdog";
		clocks = <0x0f 0xa0 0x0f 0xa0>;
		compatible = "samsung,exynos7-wdt";
		interrupts = <0x00 0x64 0x00>;
		reg = <0x00 0x10170000 0x100>;
		samsung,syscon-phandle = <0x0d>;
		timeout-sec = <0x1e>;
	};

	wlan {
		compatible = "samsung,brcm-wlan";
		gpios = <0x1f 0x06 0x01 0x1e 0x02 0x01>;
		pinctrl-0 = <0xaa 0xab>;
		pinctrl-names = "default";
		status = "okay";
	};
};
