		clocks = <0x0f 0xbe 0x0f 0x27a>;
		compatible = "samsung,exynos-spi";
		dma-names = "tx\0rx";
		interrupts = <0x00 0x1c7 0x00>;
		pinctrl-0 = <0x57>;
		pinctrl-names = "default";
		reg = <0x00 0x13930000 0x100>;
		samsung,spi-fifosize = <0x100>;
		status = "disabled";
	};

